# LLM routing (LiteLLM SDK)
LITELLM_MODEL=ollama/qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434

# Provider swap (uncomment one to override default)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# MCP transport
MCP_TRANSPORT=stdio
MCP_AUTH_TOKEN=
MCP_HTTP_BIND=127.0.0.1:8765

# Storage paths — repo-relative defaults for local dev.
# Production deploy on Debian uses absolute paths via /etc/career-scout-mcp/env loaded by systemd.
SCOUT_DATA_PATH=./data
TAGGED_MISMATCHES_DB=./tagged_mismatches.db
RUBRIC_PATH=./src/career_scout_mcp/rubric/current.txt
DIGEST_OUTPUT_PATH=./digests

# Logging
LOG_LEVEL=INFO
LOG_REDACT_PATTERNS=sk-,AKIA,ghp_,xoxb-,xoxp-,glpat-,cf_,eyJ
