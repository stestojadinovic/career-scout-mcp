# LLM routing (LiteLLM SDK)
LITELLM_MODEL=ollama/qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434

# Provider swap (uncomment one to override default)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# MCP transport
MCP_TRANSPORT=stdio
MCP_AUTH_TOKEN=
MCP_HTTP_BIND=127.0.0.1:8765

# Storage
SCOUT_DATA_PATH=/var/lib/career-scout-mcp/data
TAGGED_MISMATCHES_DB=/var/lib/career-scout-mcp/tagged_mismatches.db
RUBRIC_PATH=/opt/career-scout-mcp/rubric/current.txt
DIGEST_OUTPUT_PATH=/var/lib/career-scout-mcp/digests

# Logging
LOG_LEVEL=INFO
LOG_REDACT_PATTERNS=sk-,AKIA,ghp_,xoxb-,xoxp-,glpat-,cf_,eyJ
